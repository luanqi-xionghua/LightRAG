  <data key="d0">资本主义国家</data>
  <data key="d1">organization</data>
  <data key="d2">出现内部崩溃并可能转向法西斯主义或黑暗启蒙/新反动主义的国家。</data>
  <data key="d3">doc-df182c30660a22454291500c4c7b8508-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1787108170</data>
  <data key="d6"></data>
