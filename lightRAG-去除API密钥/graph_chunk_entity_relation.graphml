  <data key="d13"></data>
</edge>
<edge source="社会-加速主义" target="技术发展">
  <data key="d7">1.0</data>
  <data key="d8">社会-加速主义反对给技术发展设置限制，主张不断发展技术。</data>
  <data key="d9">反对限制,支持发展</data>
