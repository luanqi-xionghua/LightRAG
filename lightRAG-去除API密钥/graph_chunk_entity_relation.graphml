  <data key="d13"></data>
</edge>
<edge source="技术" target="黑暗启蒙">
  <data key="d7">1.0</data>
  <data key="d8">黑暗启蒙/新反动主义将技术异化为淘汰人类的工具，并将其加速到反人类的地步。</data>
  <data key="d9">加速,异化</data>
  <data key="d10">doc-df182c30660a22454291500c4c7b8508-chunk-003</data>
