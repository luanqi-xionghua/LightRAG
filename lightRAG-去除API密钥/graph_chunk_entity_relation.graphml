  <data key="d5">1787108170</data>
  <data key="d6"></data>
</node>
<node id="英雄史观">
  <data key="d0">英雄史观</data>
  <data key="d1">concept</data>
  <data key="d2">一种认为历史由英雄或精英推动的历史观，黑暗启蒙/新反动主义基于此认为民主限制精英从而限制人类发展。</data>
